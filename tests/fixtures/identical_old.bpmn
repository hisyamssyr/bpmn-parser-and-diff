<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             id="Definitions_Identical"
             targetNamespace="http://example.com/bpmn">
  <process id="PROC" name="Proses" isExecutable="false">
    <laneSet>
      <lane id="L" name="Lane">
        <flowNodeRef>A</flowNodeRef>
        <flowNodeRef>B</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="A" name="Mulai"/>
    <userTask id="B" name="Tugas  Satu">
      <documentation>Dokumen
        penting</documentation>
      <incoming>F9</incoming>
    </userTask>
    <sequenceFlow id="F1" sourceRef="A" targetRef="B">
      <conditionExpression>x  &gt;  0</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="F2" sourceRef="B" targetRef="A"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_Old">
    <bpmndi:BPMNPlane id="Plane_Old" bpmnElement="PROC">
      <bpmndi:BPMNShape id="Shape_A_Old" bpmnElement="A">
        <dc:Bounds x="10" y="10" width="36" height="36"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>

<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Definitions_Lanes"
             targetNamespace="http://example.com/bpmn">
  <process id="PROC" name="Proses Lama" isExecutable="false">
    <laneSet>
      <lane id="L1" name="Divisi">
        <childLaneSet>
          <lane id="L1A" name="Staff">
            <flowNodeRef>T1</flowNodeRef>
          </lane>
        </childLaneSet>
      </lane>
      <lane id="L2" name="Lane Lama">
        <flowNodeRef>T2</flowNodeRef>
      </lane>
    </laneSet>
    <userTask id="T1" name="Tugas Satu"/>
    <userTask id="T2" name="Tugas Dua"/>
    <userTask id="T3" name="Tugas Tiga"/>
  </process>
</definitions>

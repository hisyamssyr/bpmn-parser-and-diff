<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             id="Definitions_Identical"
             targetNamespace="http://example.com/bpmn">
  <process id="PROC" name="Proses" isExecutable="false">
    <sequenceFlow id="F2" sourceRef="B" targetRef="A"/>
    <sequenceFlow id="F1" sourceRef="A" targetRef="B">
      <conditionExpression>x &gt; 0</conditionExpression>
    </sequenceFlow>
    <userTask id="B" name="Tugas Satu">
      <documentation>Dokumen penting</documentation>
      <outgoing>F9</outgoing>
      <incoming>F1</incoming>
    </userTask>
    <startEvent id="A" name="Mulai"/>
    <laneSet>
      <lane id="L" name="Lane">
        <flowNodeRef>B</flowNodeRef>
        <flowNodeRef>A</flowNodeRef>
      </lane>
    </laneSet>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_New">
    <bpmndi:BPMNPlane id="Plane_New" bpmnElement="PROC">
      <bpmndi:BPMNShape id="Shape_A_New" bpmnElement="A">
        <dc:Bounds x="400" y="250" width="36" height="36"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>

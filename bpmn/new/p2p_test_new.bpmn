      <bpmndi:BPMNShape id="PART-NTF2_di" bpmnElement="PART-NTF2" isHorizontal="true">
        <dc:Bounds x="100" y="1360" width="800" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L-STAFF_di" bpmnElement="L-STAFF" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="2320" height="170" />
      </bpmndi:BPMNShape>

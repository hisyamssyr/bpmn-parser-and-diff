      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN-PAY-001_di" bpmnElement="FIN-PAY-001">
        <dc:Bounds x="2110" y="815" width="100" height="80" />
      </bpmndi:BPMNShape>

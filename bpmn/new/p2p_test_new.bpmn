        <dc:Bounds x="130" y="430" width="2320" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L-WH_di" bpmnElement="L-WH" isHorizontal="true">
        <dc:Bounds x="130" y="600" width="2320" height="170" />
      </bpmndi:BPMNShape>

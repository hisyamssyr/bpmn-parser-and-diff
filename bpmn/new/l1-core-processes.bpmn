      <bpmndi:BPMNEdge id="FLOW-P2P-L1-002_di" bpmnElement="FLOW-P2P-L1-002"><di:waypoint x="320" y="120" /><di:waypoint x="360" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-P2P-L1-003_di" bpmnElement="FLOW-P2P-L1-003"><di:waypoint x="490" y="120" /><di:waypoint x="530" y="120" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="O2C-L1-ORDER_di" bpmnElement="O2C-L1-ORDER" isExpanded="false"><dc:Bounds x="190" y="270" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="O2C-L1-DELIVER_di" bpmnElement="O2C-L1-DELIVER" isExpanded="false"><dc:Bounds x="360" y="270" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="O2C-L1-INVOICE_di" bpmnElement="O2C-L1-INVOICE" isExpanded="false"><dc:Bounds x="530" y="270" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="O2C-L1-CASH_di" bpmnElement="O2C-L1-CASH" isExpanded="false"><dc:Bounds x="700" y="270" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="O2C-L1-END_di" bpmnElement="O2C-L1-END"><dc:Bounds x="870" y="292" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PART-L1-INV_di" bpmnElement="PART-L1-INV" isHorizontal="true"><dc:Bounds x="40" y="420" width="900" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="INV-L1-START_di" bpmnElement="INV-L1-START"><dc:Bounds x="100" y="482" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="INV-L1-COUNT_di" bpmnElement="INV-L1-COUNT" isExpanded="false"><dc:Bounds x="230" y="460" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="INV-L1-APPROVE_di" bpmnElement="INV-L1-APPROVE" isExpanded="false"><dc:Bounds x="450" y="460" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="INV-L1-POST_di" bpmnElement="INV-L1-POST" isExpanded="false"><dc:Bounds x="670" y="460" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="INV-L1-END_di" bpmnElement="INV-L1-END"><dc:Bounds x="870" y="482" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PART-L1-AUTH_di" bpmnElement="PART-L1-AUTH" isHorizontal="true"><dc:Bounds x="40" y="610" width="900" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AUTH-L1-START_di" bpmnElement="AUTH-L1-START"><dc:Bounds x="100" y="712" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW-AUTH-L1-TYPE_di" bpmnElement="GW-AUTH-L1-TYPE" isMarkerVisible="true"><dc:Bounds x="170" y="705" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AUTH-L1-INVITE_di" bpmnElement="AUTH-L1-INVITE" isExpanded="false"><dc:Bounds x="300" y="630" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AUTH-L1-RESET_di" bpmnElement="AUTH-L1-RESET" isExpanded="false"><dc:Bounds x="300" y="750" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW-AUTH-L1-MERGE_di" bpmnElement="GW-AUTH-L1-MERGE" isMarkerVisible="true"><dc:Bounds x="550" y="705" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AUTH-L1-END_di" bpmnElement="AUTH-L1-END"><dc:Bounds x="660" y="712" width="36" height="36" /></bpmndi:BPMNShape>

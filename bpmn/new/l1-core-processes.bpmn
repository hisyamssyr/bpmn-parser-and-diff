      <bpmndi:BPMNEdge id="FLOW-P2P-L1-005_di" bpmnElement="FLOW-P2P-L1-005"><di:waypoint x="830" y="120" /><di:waypoint x="870" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-L1-001_di" bpmnElement="FLOW-O2C-L1-001"><di:waypoint x="136" y="310" /><di:waypoint x="190" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-L1-002_di" bpmnElement="FLOW-O2C-L1-002"><di:waypoint x="320" y="310" /><di:waypoint x="360" y="310" /></bpmndi:BPMNEdge>

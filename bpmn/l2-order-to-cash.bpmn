<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_O2C_L2" targetNamespace="https://simple-erp.local/bpmn">
  <bpmn:collaboration id="COLLAB-O2C-L2">
    <bpmn:participant id="PART-O2C-CUSTOMER" name="Customer" />
    <bpmn:participant id="PART-O2C-ERP" name="Mini ERP" processRef="O2C-L2-001" />
    <bpmn:messageFlow id="MSG-O2C-001" name="Customer order" sourceRef="PART-O2C-CUSTOMER" targetRef="SAL-SO-001" />
    <bpmn:messageFlow id="MSG-O2C-002" name="Order confirmation" sourceRef="SAL-SO-005" targetRef="PART-O2C-CUSTOMER" />
    <bpmn:messageFlow id="MSG-O2C-003" name="Goods and delivery note" sourceRef="SAL-DLV-002" targetRef="PART-O2C-CUSTOMER" />
    <bpmn:messageFlow id="MSG-O2C-004" name="Sales invoice" sourceRef="SAL-INV-001" targetRef="PART-O2C-CUSTOMER" />
    <bpmn:messageFlow id="MSG-O2C-005" name="Payment information" sourceRef="PART-O2C-CUSTOMER" targetRef="SAL-PAY-001" />
  </bpmn:collaboration>
  <bpmn:process id="O2C-L2-001" name="Order-to-Cash Level 2" isExecutable="false">
    <bpmn:laneSet id="LANESET-O2C-001">
      <bpmn:lane id="LANE-O2C-OPERATOR" name="Operator">
        <bpmn:flowNodeRef>O2C-START</bpmn:flowNodeRef><bpmn:flowNodeRef>GW-O2C-DRAFT-MERGE</bpmn:flowNodeRef><bpmn:flowNodeRef>SAL-SO-001</bpmn:flowNodeRef><bpmn:flowNodeRef>SAL-SO-002</bpmn:flowNodeRef><bpmn:flowNodeRef>GW-O2C-DELIVERY-MERGE</bpmn:flowNodeRef><bpmn:flowNodeRef>SAL-DLV-001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE-O2C-ADMIN" name="Admin">
        <bpmn:flowNodeRef>SAL-SO-004</bpmn:flowNodeRef><bpmn:flowNodeRef>GW-O2C-APPROVED</bpmn:flowNodeRef><bpmn:flowNodeRef>O2C-END-REJECTED</bpmn:flowNodeRef><bpmn:flowNodeRef>SAL-PAY-001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE-O2C-SYSTEM" name="System">
        <bpmn:flowNodeRef>SAL-SO-003</bpmn:flowNodeRef><bpmn:flowNodeRef>GW-O2C-STOCK</bpmn:flowNodeRef><bpmn:flowNodeRef>SAL-SO-005</bpmn:flowNodeRef><bpmn:flowNodeRef>SAL-DLV-002</bpmn:flowNodeRef><bpmn:flowNodeRef>GW-O2C-DELIVERED</bpmn:flowNodeRef><bpmn:flowNodeRef>SAL-INV-001</bpmn:flowNodeRef><bpmn:flowNodeRef>GW-O2C-PAY-MERGE</bpmn:flowNodeRef><bpmn:flowNodeRef>SAL-PAY-002</bpmn:flowNodeRef><bpmn:flowNodeRef>GW-O2C-PAID</bpmn:flowNodeRef><bpmn:flowNodeRef>SAL-SO-006</bpmn:flowNodeRef><bpmn:flowNodeRef>O2C-END-COMPLETED</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="O2C-START" name="Customer order received"><bpmn:outgoing>FLOW-O2C-001</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW-O2C-DRAFT-MERGE" name="Prepare order draft"><bpmn:incoming>FLOW-O2C-001</bpmn:incoming><bpmn:incoming>FLOW-O2C-005</bpmn:incoming><bpmn:outgoing>FLOW-O2C-001A</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="SAL-SO-001" name="Create or revise sales order"><bpmn:incoming>FLOW-O2C-001A</bpmn:incoming><bpmn:outgoing>FLOW-O2C-002</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="SAL-SO-003" name="Validate available stock"><bpmn:incoming>FLOW-O2C-002</bpmn:incoming><bpmn:outgoing>FLOW-O2C-003</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW-O2C-STOCK" name="Stock available?" default="FLOW-O2C-005"><bpmn:incoming>FLOW-O2C-003</bpmn:incoming><bpmn:outgoing>FLOW-O2C-004</bpmn:outgoing><bpmn:outgoing>FLOW-O2C-005</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="SAL-SO-002" name="Submit sales order"><bpmn:incoming>FLOW-O2C-004</bpmn:incoming><bpmn:outgoing>FLOW-O2C-006</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="SAL-SO-004" name="Review sales order"><bpmn:incoming>FLOW-O2C-006</bpmn:incoming><bpmn:outgoing>FLOW-O2C-007</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GW-O2C-APPROVED" name="Order approved?" default="FLOW-O2C-009"><bpmn:incoming>FLOW-O2C-007</bpmn:incoming><bpmn:outgoing>FLOW-O2C-008</bpmn:outgoing><bpmn:outgoing>FLOW-O2C-009</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="O2C-END-REJECTED" name="Order rejected"><bpmn:incoming>FLOW-O2C-009</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="SAL-SO-005" name="Confirm order to customer"><bpmn:incoming>FLOW-O2C-008</bpmn:incoming><bpmn:outgoing>FLOW-O2C-010</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW-O2C-DELIVERY-MERGE" name="Prepare next delivery"><bpmn:incoming>FLOW-O2C-010</bpmn:incoming><bpmn:incoming>FLOW-O2C-013</bpmn:incoming><bpmn:outgoing>FLOW-O2C-010A</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="SAL-DLV-001" name="Create delivery"><bpmn:incoming>FLOW-O2C-010A</bpmn:incoming><bpmn:outgoing>FLOW-O2C-011</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="SAL-DLV-002" name="Post delivery and stock"><bpmn:incoming>FLOW-O2C-011</bpmn:incoming><bpmn:outgoing>FLOW-O2C-012</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW-O2C-DELIVERED" name="All goods delivered?" default="FLOW-O2C-013"><bpmn:incoming>FLOW-O2C-012</bpmn:incoming><bpmn:outgoing>FLOW-O2C-013</bpmn:outgoing><bpmn:outgoing>FLOW-O2C-014</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SAL-INV-001" name="Generate sales invoice"><bpmn:incoming>FLOW-O2C-014</bpmn:incoming><bpmn:outgoing>FLOW-O2C-015</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW-O2C-PAY-MERGE" name="Await customer payment"><bpmn:incoming>FLOW-O2C-015</bpmn:incoming><bpmn:incoming>FLOW-O2C-019</bpmn:incoming><bpmn:outgoing>FLOW-O2C-015A</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="SAL-PAY-001" name="Record customer payment"><bpmn:incoming>FLOW-O2C-015A</bpmn:incoming><bpmn:outgoing>FLOW-O2C-016</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="SAL-PAY-002" name="Post customer payment"><bpmn:incoming>FLOW-O2C-016</bpmn:incoming><bpmn:outgoing>FLOW-O2C-017</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW-O2C-PAID" name="Invoice fully paid?" default="FLOW-O2C-019"><bpmn:incoming>FLOW-O2C-017</bpmn:incoming><bpmn:outgoing>FLOW-O2C-018</bpmn:outgoing><bpmn:outgoing>FLOW-O2C-019</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SAL-SO-006" name="Close sales order"><bpmn:incoming>FLOW-O2C-018</bpmn:incoming><bpmn:outgoing>FLOW-O2C-020</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="O2C-END-COMPLETED" name="Order completed"><bpmn:incoming>FLOW-O2C-020</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="FLOW-O2C-001" sourceRef="O2C-START" targetRef="GW-O2C-DRAFT-MERGE" />
    <bpmn:sequenceFlow id="FLOW-O2C-001A" sourceRef="GW-O2C-DRAFT-MERGE" targetRef="SAL-SO-001" />
    <bpmn:sequenceFlow id="FLOW-O2C-002" sourceRef="SAL-SO-001" targetRef="SAL-SO-003" />
    <bpmn:sequenceFlow id="FLOW-O2C-003" sourceRef="SAL-SO-003" targetRef="GW-O2C-STOCK" />
    <bpmn:sequenceFlow id="FLOW-O2C-004" name="Available" sourceRef="GW-O2C-STOCK" targetRef="SAL-SO-002"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">stockAvailable = true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FLOW-O2C-005" name="Revise quantity" sourceRef="GW-O2C-STOCK" targetRef="GW-O2C-DRAFT-MERGE" />
    <bpmn:sequenceFlow id="FLOW-O2C-006" sourceRef="SAL-SO-002" targetRef="SAL-SO-004" />
    <bpmn:sequenceFlow id="FLOW-O2C-007" sourceRef="SAL-SO-004" targetRef="GW-O2C-APPROVED" />
    <bpmn:sequenceFlow id="FLOW-O2C-008" name="Approved" sourceRef="GW-O2C-APPROVED" targetRef="SAL-SO-005"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision = 'APPROVED'</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FLOW-O2C-009" name="Rejected" sourceRef="GW-O2C-APPROVED" targetRef="O2C-END-REJECTED" />
    <bpmn:sequenceFlow id="FLOW-O2C-010" sourceRef="SAL-SO-005" targetRef="GW-O2C-DELIVERY-MERGE" />
    <bpmn:sequenceFlow id="FLOW-O2C-010A" sourceRef="GW-O2C-DELIVERY-MERGE" targetRef="SAL-DLV-001" />
    <bpmn:sequenceFlow id="FLOW-O2C-011" sourceRef="SAL-DLV-001" targetRef="SAL-DLV-002" />
    <bpmn:sequenceFlow id="FLOW-O2C-012" sourceRef="SAL-DLV-002" targetRef="GW-O2C-DELIVERED" />
    <bpmn:sequenceFlow id="FLOW-O2C-013" name="Remaining quantity" sourceRef="GW-O2C-DELIVERED" targetRef="GW-O2C-DELIVERY-MERGE" />
    <bpmn:sequenceFlow id="FLOW-O2C-014" name="Complete" sourceRef="GW-O2C-DELIVERED" targetRef="SAL-INV-001"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allGoodsDelivered = true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FLOW-O2C-015" sourceRef="SAL-INV-001" targetRef="GW-O2C-PAY-MERGE" />
    <bpmn:sequenceFlow id="FLOW-O2C-015A" sourceRef="GW-O2C-PAY-MERGE" targetRef="SAL-PAY-001" />
    <bpmn:sequenceFlow id="FLOW-O2C-016" sourceRef="SAL-PAY-001" targetRef="SAL-PAY-002" />
    <bpmn:sequenceFlow id="FLOW-O2C-017" sourceRef="SAL-PAY-002" targetRef="GW-O2C-PAID" />
    <bpmn:sequenceFlow id="FLOW-O2C-018" name="Fully paid" sourceRef="GW-O2C-PAID" targetRef="SAL-SO-006"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outstandingAmount = 0</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FLOW-O2C-019" name="Balance remains" sourceRef="GW-O2C-PAID" targetRef="GW-O2C-PAY-MERGE" />
    <bpmn:sequenceFlow id="FLOW-O2C-020" sourceRef="SAL-SO-006" targetRef="O2C-END-COMPLETED" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_O2C_L2">
    <bpmndi:BPMNPlane id="Plane_O2C_L2" bpmnElement="COLLAB-O2C-L2">
      <bpmndi:BPMNShape id="PART-O2C-CUSTOMER_di" bpmnElement="PART-O2C-CUSTOMER" isHorizontal="true"><dc:Bounds x="40" y="20" width="2820" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PART-O2C-ERP_di" bpmnElement="PART-O2C-ERP" isHorizontal="true"><dc:Bounds x="40" y="100" width="2820" height="480" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LANE-O2C-OPERATOR_di" bpmnElement="LANE-O2C-OPERATOR" isHorizontal="true"><dc:Bounds x="70" y="100" width="2790" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LANE-O2C-ADMIN_di" bpmnElement="LANE-O2C-ADMIN" isHorizontal="true"><dc:Bounds x="70" y="260" width="2790" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LANE-O2C-SYSTEM_di" bpmnElement="LANE-O2C-SYSTEM" isHorizontal="true"><dc:Bounds x="70" y="420" width="2790" height="160" /></bpmndi:BPMNShape>

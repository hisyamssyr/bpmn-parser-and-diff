      <bpmndi:BPMNShape id="SAL-SO-001_di" bpmnElement="SAL-SO-001"><dc:Bounds x="180" y="140" width="120" height="80" /><bpmndi:BPMNLabel /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SAL-SO-003_di" bpmnElement="SAL-SO-003"><dc:Bounds x="350" y="460" width="120" height="80" /><bpmndi:BPMNLabel /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW-O2C-STOCK_di" bpmnElement="GW-O2C-STOCK" isMarkerVisible="true"><dc:Bounds x="520" y="475" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SAL-SO-002_di" bpmnElement="SAL-SO-002"><dc:Bounds x="640" y="140" width="120" height="80" /><bpmndi:BPMNLabel /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SAL-SO-004_di" bpmnElement="SAL-SO-004"><dc:Bounds x="810" y="300" width="120" height="80" /><bpmndi:BPMNLabel /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW-O2C-APPROVED_di" bpmnElement="GW-O2C-APPROVED" isMarkerVisible="true"><dc:Bounds x="980" y="315" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="O2C-END-REJECTED_di" bpmnElement="O2C-END-REJECTED"><dc:Bounds x="1090" y="372" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SAL-SO-005_di" bpmnElement="SAL-SO-005"><dc:Bounds x="1080" y="460" width="120" height="80" /><bpmndi:BPMNLabel /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW-O2C-DELIVERY-MERGE_di" bpmnElement="GW-O2C-DELIVERY-MERGE" isMarkerVisible="true"><dc:Bounds x="1210" y="255" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SAL-DLV-001_di" bpmnElement="SAL-DLV-001"><dc:Bounds x="1250" y="140" width="120" height="80" /><bpmndi:BPMNLabel /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SAL-DLV-002_di" bpmnElement="SAL-DLV-002"><dc:Bounds x="1420" y="460" width="120" height="80" /><bpmndi:BPMNLabel /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW-O2C-DELIVERED_di" bpmnElement="GW-O2C-DELIVERED" isMarkerVisible="true"><dc:Bounds x="1590" y="475" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SAL-INV-001_di" bpmnElement="SAL-INV-001"><dc:Bounds x="1710" y="460" width="120" height="80" /><bpmndi:BPMNLabel /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW-O2C-PAY-MERGE_di" bpmnElement="GW-O2C-PAY-MERGE" isMarkerVisible="true"><dc:Bounds x="1840" y="390" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SAL-PAY-001_di" bpmnElement="SAL-PAY-001"><dc:Bounds x="1880" y="300" width="120" height="80" /><bpmndi:BPMNLabel /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SAL-PAY-002_di" bpmnElement="SAL-PAY-002"><dc:Bounds x="2050" y="460" width="120" height="80" /><bpmndi:BPMNLabel /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW-O2C-PAID_di" bpmnElement="GW-O2C-PAID" isMarkerVisible="true"><dc:Bounds x="2220" y="475" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SAL-SO-006_di" bpmnElement="SAL-SO-006"><dc:Bounds x="2380" y="460" width="120" height="80" /><bpmndi:BPMNLabel /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="O2C-END-COMPLETED_di" bpmnElement="O2C-END-COMPLETED"><dc:Bounds x="2580" y="482" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="FLOW-O2C-001_di" bpmnElement="FLOW-O2C-001"><di:waypoint x="136" y="180" /><di:waypoint x="170" y="180" /><di:waypoint x="170" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-001A_di" bpmnElement="FLOW-O2C-001A"><di:waypoint x="195" y="260" /><di:waypoint x="240" y="260" /><di:waypoint x="240" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-002_di" bpmnElement="FLOW-O2C-002"><di:waypoint x="300" y="180" /><di:waypoint x="325" y="180" /><di:waypoint x="325" y="500" /><di:waypoint x="350" y="500" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-003_di" bpmnElement="FLOW-O2C-003"><di:waypoint x="470" y="500" /><di:waypoint x="520" y="500" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-004_di" bpmnElement="FLOW-O2C-004"><di:waypoint x="545" y="475" /><di:waypoint x="545" y="180" /><di:waypoint x="640" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-005_di" bpmnElement="FLOW-O2C-005"><di:waypoint x="520" y="500" /><di:waypoint x="170" y="500" /><di:waypoint x="170" y="285" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-006_di" bpmnElement="FLOW-O2C-006"><di:waypoint x="760" y="180" /><di:waypoint x="785" y="180" /><di:waypoint x="785" y="340" /><di:waypoint x="810" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-007_di" bpmnElement="FLOW-O2C-007"><di:waypoint x="930" y="340" /><di:waypoint x="980" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-008_di" bpmnElement="FLOW-O2C-008"><di:waypoint x="1005" y="365" /><di:waypoint x="1005" y="500" /><di:waypoint x="1080" y="500" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-009_di" bpmnElement="FLOW-O2C-009"><di:waypoint x="1005" y="365" /><di:waypoint x="1005" y="390" /><di:waypoint x="1090" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-010_di" bpmnElement="FLOW-O2C-010"><di:waypoint x="1200" y="500" /><di:waypoint x="1235" y="500" /><di:waypoint x="1235" y="305" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-010A_di" bpmnElement="FLOW-O2C-010A"><di:waypoint x="1235" y="255" /><di:waypoint x="1235" y="180" /><di:waypoint x="1250" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-011_di" bpmnElement="FLOW-O2C-011"><di:waypoint x="1370" y="180" /><di:waypoint x="1395" y="180" /><di:waypoint x="1395" y="500" /><di:waypoint x="1420" y="500" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-012_di" bpmnElement="FLOW-O2C-012"><di:waypoint x="1540" y="500" /><di:waypoint x="1590" y="500" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-013_di" bpmnElement="FLOW-O2C-013"><di:waypoint x="1615" y="475" /><di:waypoint x="1615" y="280" /><di:waypoint x="1260" y="280" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-014_di" bpmnElement="FLOW-O2C-014"><di:waypoint x="1640" y="500" /><di:waypoint x="1710" y="500" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-015_di" bpmnElement="FLOW-O2C-015"><di:waypoint x="1830" y="500" /><di:waypoint x="1865" y="500" /><di:waypoint x="1865" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FLOW-O2C-015A_di" bpmnElement="FLOW-O2C-015A"><di:waypoint x="1890" y="415" /><di:waypoint x="1940" y="415" /><di:waypoint x="1940" y="380" /></bpmndi:BPMNEdge>

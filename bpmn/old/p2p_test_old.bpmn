<?xml version="1.0" encoding="UTF-8"?>
<!-- FILE UJI SINTETIS untuk BPMN parser/diff (bukan bagian dari Simple-ERP). Versi LAMA. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_P2P_TEST" targetNamespace="http://example.org/bpmn/p2p-test">
  <bpmn:collaboration id="COLL-1">
    <bpmn:participant id="PART-P2P" name="Procure to Pay" processRef="P2P" />
    <bpmn:participant id="PART-NTF" name="Notifikasi" processRef="PROC-NOTIFY" />
  </bpmn:collaboration>
  <bpmn:process id="P2P" name="Procure to Pay" isExecutable="false">
    <bpmn:laneSet id="LS-P2P">
      <bpmn:lane id="L-STAFF" name="Staff Purchasing">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PUR-PR-001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CALL-NOTIF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PUR-PO-001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PUR-PO-002</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L-MGR" name="Manajer">
        <bpmn:flowNodeRef>PUR-PR-002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW-APPROVE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END-REJECT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE-TIMEOUT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ESC-001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L-WH" name="Gudang">
        <bpmn:flowNodeRef>INV-GR-001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INV-GR-002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW-QC</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L-FIN" name="Finance">
        <bpmn:childLaneSet id="LS-L-FIN">
          <bpmn:lane id="L-FIN-AP" name="Accounts Payable">
            <bpmn:flowNodeRef>EVT-WAIT</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN-INV-002</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="L-FIN-TRS" name="Treasury">
            <bpmn:flowNodeRef>FIN-PAY-001</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>END-OK</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
      <bpmn:lane id="L-AUD" name="Auditor Internal">
        <bpmn:flowNodeRef>AUD-001</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="Kebutuhan Barang Muncul">
      <bpmn:outgoing>F-001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="PUR-PR-001" name="Buat Purchase Request" camunda:assignee="staff">
      <bpmn:incoming>F-001</bpmn:incoming>
      <bpmn:outgoing>F-002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="PUR-PR-002" name="Review Purchase Request">
      <bpmn:incoming>F-002</bpmn:incoming>
      <bpmn:outgoing>F-003</bpmn:outgoing>
      <bpmn:startEvent id="SUB-START">
        <bpmn:outgoing>SUB-F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SUB-001" name="Cek Anggaran">
        <bpmn:incoming>SUB-F1</bpmn:incoming>
        <bpmn:outgoing>SUB-F2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SUB-END">
        <bpmn:incoming>SUB-F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SUB-F1" sourceRef="SUB-START" targetRef="SUB-001" />
      <bpmn:sequenceFlow id="SUB-F2" sourceRef="SUB-001" targetRef="SUB-END" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="GW-APPROVE" name="Disetujui?" gatewayDirection="Diverging" default="F-005">
      <bpmn:incoming>F-003</bpmn:incoming>
      <bpmn:incoming>F-017</bpmn:incoming>
      <bpmn:outgoing>F-004</bpmn:outgoing>
      <bpmn:outgoing>F-005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="END-REJECT" name="PR Ditolak">
      <bpmn:incoming>F-005</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="CALL-NOTIF" name="Kirim Notifikasi" calledElement="PROC-NOTIFY">
      <bpmn:extensionElements><camunda:properties><camunda:property name="channel" value="email" /></camunda:properties></bpmn:extensionElements>
      <bpmn:incoming>F-004</bpmn:incoming>
      <bpmn:outgoing>F-006</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="PUR-PO-001" name="Buat Purchase Order">
      <bpmn:incoming>F-006</bpmn:incoming>
      <bpmn:outgoing>F-007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="PUR-PO-002" name="Kirim PO ke Supplier">
      <bpmn:incoming>F-007</bpmn:incoming>
      <bpmn:outgoing>F-008</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="INV-GR-001" name="Terima Barang">
      <bpmn:incoming>F-008</bpmn:incoming>
      <bpmn:incoming>F-012</bpmn:incoming>
      <bpmn:outgoing>F-009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="INV-GR-002" name="Periksa Kualitas Barang">
      <bpmn:incoming>F-009</bpmn:incoming>
      <bpmn:outgoing>F-010</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW-QC" name="Barang Sesuai?" gatewayDirection="Diverging" default="F-012">
      <bpmn:incoming>F-010</bpmn:incoming>
      <bpmn:outgoing>F-011</bpmn:outgoing>
      <bpmn:outgoing>F-012</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="EVT-WAIT" name="Tunggu Invoice">
      <bpmn:incoming>F-011</bpmn:incoming>
      <bpmn:outgoing>F-013</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="FIN-INV-002" name="Cocokkan Invoice">
      <bpmn:incoming>F-013</bpmn:incoming>
      <bpmn:outgoing>F-014</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="FIN-PAY-001" name="Bayar Supplier">
      <bpmn:incoming>F-014</bpmn:incoming>
      <bpmn:outgoing>F-015</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="AUD-001" name="Audit Sampling">
      <bpmn:incoming>F-015</bpmn:incoming>
      <bpmn:outgoing>F-019</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="END-OK" name="Pembayaran Selesai">
      <bpmn:incoming>F-019</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="BE-TIMEOUT" name="Approval Timeout" cancelActivity="true" attachedToRef="PUR-PR-002">
      <bpmn:outgoing>F-016</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="ESC-001" name="Eskalasi ke Direktur">
      <bpmn:incoming>F-016</bpmn:incoming>
      <bpmn:outgoing>F-017</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F-001" sourceRef="START" targetRef="PUR-PR-001" />
    <bpmn:sequenceFlow id="F-002" sourceRef="PUR-PR-001" targetRef="PUR-PR-002" />
    <bpmn:sequenceFlow id="F-003" sourceRef="PUR-PR-002" targetRef="GW-APPROVE" />
    <bpmn:sequenceFlow id="F-004" name="Ya" sourceRef="GW-APPROVE" targetRef="CALL-NOTIF">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F-005" name="Tidak" sourceRef="GW-APPROVE" targetRef="END-REJECT" />
    <bpmn:sequenceFlow id="F-006" sourceRef="CALL-NOTIF" targetRef="PUR-PO-001" />
    <bpmn:sequenceFlow id="F-007" sourceRef="PUR-PO-001" targetRef="PUR-PO-002" />
    <bpmn:sequenceFlow id="F-008" sourceRef="PUR-PO-002" targetRef="INV-GR-001" />
    <bpmn:sequenceFlow id="F-009" sourceRef="INV-GR-001" targetRef="INV-GR-002" />
    <bpmn:sequenceFlow id="F-010" sourceRef="INV-GR-002" targetRef="GW-QC" />
    <bpmn:sequenceFlow id="F-011" name="Sesuai" sourceRef="GW-QC" targetRef="EVT-WAIT">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${qc == 'OK'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F-012" name="Tidak Sesuai" sourceRef="GW-QC" targetRef="INV-GR-001" />
    <bpmn:sequenceFlow id="F-013" sourceRef="EVT-WAIT" targetRef="FIN-INV-002" />
    <bpmn:sequenceFlow id="F-014" sourceRef="FIN-INV-002" targetRef="FIN-PAY-001" />
    <bpmn:sequenceFlow id="F-015" sourceRef="FIN-PAY-001" targetRef="AUD-001" />
    <bpmn:sequenceFlow id="F-016" sourceRef="BE-TIMEOUT" targetRef="ESC-001" />
    <bpmn:sequenceFlow id="F-017" sourceRef="ESC-001" targetRef="GW-APPROVE" />
    <bpmn:sequenceFlow id="F-019" sourceRef="AUD-001" targetRef="END-OK" />
  </bpmn:process>
  <bpmn:process id="PROC-NOTIFY" name="Proses Notifikasi" isExecutable="false">
    <bpmn:startEvent id="NTF-START" name="Mulai Notifikasi">
      <bpmn:outgoing>NTF-F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="NTF-001" name="Kirim Email">
      <bpmn:incoming>NTF-F1</bpmn:incoming>
      <bpmn:outgoing>NTF-F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="NTF-END" name="Notifikasi Terkirim">
      <bpmn:incoming>NTF-F2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="NTF-F1" sourceRef="NTF-START" targetRef="NTF-001" />
    <bpmn:sequenceFlow id="NTF-F2" sourceRef="NTF-001" targetRef="NTF-END" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
